{
  "name": "markos-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-server.mjs dev",
    "build": "npm run validate && next build",
    "start": "node scripts/next-server.mjs start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "node scripts/clean-next-types.mjs && tsc --noEmit",
    "audit:check": "npm audit --audit-level=low",
    "deps:check": "node scripts/check-deps.mjs",
    "validate": "npm run lint && npm run typecheck && npm run audit:check && npm run deps:check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.2",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@mui/x-date-pickers": "^9.15.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-oauth/google": "^0.13.5",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "isomorphic-dompurify": "^4.6.0",
    "luxon": "^3.7.2",
    "next": "16.4.2",
    "notistack": "^3.0.2",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "braces": "npm:@franciscosolis/braces@3.1.1",
    "fast-uri": "4.2.2",
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "js-yaml": "4.3.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/luxon": "^3.7.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
